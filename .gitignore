# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables & secrets (NEVER commit)
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Key / secret files — belt-and-suspenders patterns
**/*_API_KEY*
**/*_SECRET*
**/*_KEY*
**/secrets.*
**/secret.*
**/credentials.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Build output
dist/
frontend/dist/
build/

# Database files (contain encrypted user data — never commit)
*.db
*.sqlite
*.sqlite3
backend/*.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp
*.swo

# Migration helper output
backend/migrate-encrypt.log
